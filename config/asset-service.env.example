# 비밀값은 넣지 않는다. 경로는 저장소 루트 기준 또는 절대 경로다.
# 따옴표·export·변수 치환 없이 KEY=value 형식으로 작성한다.
ASSET_DB_STAGE=local
ASSET_DB_HOST=127.0.0.1
ASSET_DB_PORT=25432
ASSET_DB_NAME=slime_assets_local
# 실제 생성한 런타임 LOGIN 계정으로 변경한다.
ASSET_DB_USER=asset_service_runtime
ASSET_DB_PASSWORD_FILE=.local/secrets/asset_runtime_password
ASSET_API_LISTEN_PORT=8791
ASSET_SERVICE_ALLOWED_HOSTS=localhost,127.0.0.1
ASSET_SERVICE_AUTH_MODE=local-loopback
